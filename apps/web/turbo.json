{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "CI",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "DB_URL",
        "ENCRYPTION_KEY",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_VERCEL_URL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_BRANCH_URL",
        "LOOPS_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WAREHOUSE_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "ADMIN_PHONE_NUMBER",
        "BLOB_READ_WRITE_TOKEN",
        "IDENTITY_ENCRYPTION_KEY",
        "ZOHO_BILLING_ORGANIZATION_ID",
        "ZOHO_BILLING_PLAN_CODE",
        "ZOHO_BILLING_EXTRA_CASE_ADDON",
        "ZOHO_BILLING_WEBHOOK_SECRET",
        "CELLAR_BILLING_MODE",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "ZEBRA_PRINTER_IP",
        "WINELABS_USER_ID",
        "WINELABS_BASE_URL",
        "WINELABS_MONTHLY_CREDIT_CAP",
        "NEXT_PUBLIC_ZEBRA_PRINTER_IP",
        "TRIGGER_SECRET_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**/*"]
    },
    "start": {
      "persistent": true
    },
    "studio": {
      "persistent": true
    }
  }
}
